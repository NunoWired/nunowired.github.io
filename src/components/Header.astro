---
interface Props {
  lang: 'pt-BR' | 'en-US';
}

const { lang } = Astro.props;
const isPt = lang === 'pt-BR';

const links = isPt
  ? [
      { href: '/#projetos', label: 'Projetos' },
      { href: '/#sobre', label: 'Sobre' },
      { href: '/#competencias', label: 'Competências' },
      { href: '/#experiencia', label: 'Experiência' },
      { href: '/#contato', label: 'Contato' }
    ]
  : [
      { href: '/en/#projects', label: 'Projects' },
      { href: '/en/#about', label: 'About' },
      { href: '/en/#skills', label: 'Skills' },
      { href: '/en/#experience', label: 'Experience' },
      { href: '/en/#contact', label: 'Contact' }
    ];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent py-3 transition-all">
  <div class="mx-auto flex w-[min(1120px,92%)] items-center justify-between gap-4">
    <a href={isPt ? '/' : '/en/'} class="flex items-center gap-3 font-extrabold">
      <img src="https://avatars.githubusercontent.com/u/44872423?v=4" alt="Antonio Nunes" width="38" height="38" class="h-9 w-9 rounded-full object-cover" />
      <span>Antonio Nunes</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label={isPt ? 'Navegação principal' : 'Main navigation'}>
      {links.map((link) => <a href={link.href} class="text-sm font-semibold text-slate-600 transition hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400">{link.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/" class={`rounded-full px-3 py-1.5 text-xs font-bold ${isPt ? 'bg-blue-600 text-white' : 'text-slate-600 dark:text-slate-300'}`}>PT</a>
      <a href="/en/" class={`rounded-full px-3 py-1.5 text-xs font-bold ${!isPt ? 'bg-blue-600 text-white' : 'text-slate-600 dark:text-slate-300'}`}>EN</a>
      <button data-theme-toggle class="grid h-9 w-9 place-items-center rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900" aria-label={isPt ? 'Alternar tema' : 'Toggle theme'}>◐</button>
      <button data-menu-toggle class="grid h-9 w-9 place-items-center rounded-xl border border-slate-200 bg-white md:hidden dark:border-slate-700 dark:bg-slate-900" aria-label={isPt ? 'Abrir menu' : 'Open menu'} aria-expanded="false">☰</button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="mx-auto mt-3 w-[92%] rounded-2xl border border-slate-200 bg-white p-3 md:hidden dark:border-slate-700 dark:bg-slate-900">
    {links.map((link) => <a href={link.href} class="block rounded-xl px-4 py-3 font-semibold hover:bg-slate-100 dark:hover:bg-slate-800">{link.label}</a>)}
  </div>
</header>