---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MotionReveal from '../components/MotionReveal.tsx';
---

<BaseLayout
  title="Antonio Nunes | Desenvolvedor de Software & Web"
  description="Portfólio 2.0.0 de Antonio Nunes, desenvolvedor de software e web. Projetos atuais: PsiCompass e Projeto Sah."
  lang="pt-BR"
  canonical="https://nunowired.github.io/"
  alternate="https://nunowired.github.io/en/"
>
  <Header lang="pt-BR" />

  <main>
    <section id="inicio" class="relative overflow-hidden px-4 pb-20 pt-36">
      <div class="pointer-events-none absolute -right-40 -top-40 h-[520px] w-[520px] rounded-full bg-blue-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 h-[420px] w-[420px] rounded-full bg-violet-500/20 blur-3xl"></div>

      <div class="relative mx-auto grid w-[min(1120px,100%)] items-center gap-14 lg:grid-cols-[1.1fr_.9fr]">
        <MotionReveal client:visible>
          <span class="inline-block rounded-full border border-blue-200 bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-blue-600 dark:border-blue-800 dark:bg-slate-900 dark:text-blue-400">Portfólio 2.0.0</span>
          <h1 class="mt-5 text-5xl font-extrabold leading-[1.05] tracking-tight md:text-6xl">
            Desenvolvedor de <span class="gradient-text">Software & Web</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-600 dark:text-slate-300">
            Sou Antonio Nunes. Hoje, concentro minha atuação no desenvolvimento de sistemas web, interfaces modernas e soluções digitais. Combino formação em Análise e Desenvolvimento de Sistemas com uma base sólida em TI, suporte e infraestrutura.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#projetos" class="rounded-full bg-blue-600 px-6 py-3 font-bold text-white shadow-lg shadow-blue-600/25 transition hover:-translate-y-0.5">Ver projetos atuais</a>
            <a href="https://github.com/NunoWired" target="_blank" rel="noopener" class="rounded-full border border-slate-300 bg-white px-6 py-3 font-bold transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900">GitHub</a>
          </div>
        </MotionReveal>

        <MotionReveal client:visible delay={0.12} className="relative grid place-items-center">
          <img src="https://avatars.githubusercontent.com/u/44872423?v=4" alt="Foto de perfil de Antonio Nunes" width="280" height="280" class="h-64 w-64 rounded-[2rem] border-4 border-white object-cover shadow-2xl md:h-72 md:w-72 dark:border-slate-800" />
          <div class="absolute left-0 top-4 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold shadow-xl dark:border-slate-700 dark:bg-slate-900">PsiCompass<br /><span class="text-xs font-medium text-slate-500">Sistema web em evolução</span></div>
          <div class="absolute bottom-4 right-0 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold shadow-xl dark:border-slate-700 dark:bg-slate-900">Projeto Sah<br /><span class="text-xs font-medium text-slate-500">Landing page responsiva</span></div>
        </MotionReveal>
      </div>
    </section>

    <section id="projetos" class="border-y border-slate-200 bg-white px-4 py-24 dark:border-slate-800 dark:bg-slate-900">
      <div class="mx-auto w-[min(1120px,100%)]">
        <MotionReveal client:visible>
          <span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">Atuação atual</span>
          <h2 class="mt-3 text-4xl font-extrabold tracking-tight">Projetos em desenvolvimento</h2>
          <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-300">Estes são os trabalhos recentes que representam minha atuação atual em desenvolvimento de software e criação de sites.</p>
        </MotionReveal>

        <div class="mt-12 grid gap-6 md:grid-cols-2">
          <MotionReveal client:visible>
            <article class="group h-full overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-xl transition hover:-translate-y-2 dark:border-slate-700 dark:bg-slate-950">
              <img src="/psicompass01.jpg" alt="Tela do sistema PsiCompass" class="h-56 w-full object-cover object-top transition duration-500 group-hover:scale-105" loading="lazy" />
              <div class="p-7">
                <div class="flex items-center justify-between"><span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300">Sistema web</span><span class="text-xs font-semibold text-slate-500">Em evolução</span></div>
                <h3 class="mt-4 text-2xl font-bold">PsiCompass</h3>
                <p class="mt-3 text-slate-600 dark:text-slate-300">Sistema web para apoio à gestão de consultórios de psicologia, com pacientes, sessões, despesas, profissionais e convites de acesso.</p>
                <a href="/projetos/psicompass" class="mt-5 inline-block font-bold text-blue-600 hover:underline dark:text-blue-400">Ver projeto e telas →</a>
              </div>
            </article>
          </MotionReveal>

          <MotionReveal client:visible delay={0.12}>
            <article class="group h-full overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-xl transition hover:-translate-y-2 dark:border-slate-700 dark:bg-slate-950">
              <img src="/projetosah01.jpg" alt="Tela do Projeto Sah" class="h-56 w-full object-cover object-top transition duration-500 group-hover:scale-105" loading="lazy" />
              <div class="p-7">
                <div class="flex items-center justify-between"><span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-bold text-violet-700 dark:bg-violet-950 dark:text-violet-300">Desenvolvimento web</span><span class="text-xs font-semibold text-slate-500">Em andamento</span></div>
                <h3 class="mt-4 text-2xl font-bold">Projeto Sah</h3>
                <p class="mt-3 text-slate-600 dark:text-slate-300">Landing page responsiva, acessível e de página única para divulgação de evento musical católico, com estrutura para venda de ingressos via Pix.</p>
                <a href="/projetos/projeto-sah" class="mt-5 inline-block font-bold text-violet-600 hover:underline dark:text-violet-400">Ver projeto e telas →</a>
              </div>
            </article>
          </MotionReveal>
        </div>
      </div>
    </section>

    <section id="sobre" class="px-4 py-24">
      <div class="mx-auto grid w-[min(1120px,100%)] gap-8 lg:grid-cols-2">
        <MotionReveal client:visible>
          <span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">Sobre mim</span>
          <h2 class="mt-3 text-4xl font-extrabold tracking-tight">Experiência em TI, nova fase em desenvolvimento.</h2>
          <p class="mt-5 text-slate-600 dark:text-slate-300">Tenho uma trajetória consolidada em tecnologia, com atuação em suporte técnico, implantação de sistemas, redes, servidores, bancos de dados e atendimento a usuários. Atualmente, estou direcionando minha carreira para o desenvolvimento de software e a criação de sites e sistemas web.</p>
        </MotionReveal>
        <MotionReveal client:visible delay={0.12}>
          <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-xl dark:border-slate-700 dark:bg-slate-900">
            <h3 class="text-2xl font-bold">Portfólio 2.0.0</h3>
            <p class="mt-4 text-slate-600 dark:text-slate-300">Esta versão foi atualizada a partir de uma estrutura inicial em HTML, CSS e JavaScript. O projeto foi incrementado com <strong>Astro</strong>, <strong>React</strong>, <strong>TypeScript</strong>, <strong>Tailwind CSS</strong> e <strong>Framer Motion</strong> para criar uma experiência mais moderna, rápida, organizada e acessível.</p>
            <p class="mt-4 text-slate-600 dark:text-slate-300">O objetivo foi evoluir o portfólio de uma página estática para uma base mais profissional de desenvolvimento web, com componentes reutilizáveis, animações discretas, temas claro e escuro, suporte a múltiplos idiomas e publicação automatizada pelo GitHub Pages.</p>
          </div>
        </MotionReveal>
      </div>
    </section>

    <section id="competencias" class="border-y border-slate-200 bg-white px-4 py-24 dark:border-slate-800 dark:bg-slate-900">
      <div class="mx-auto w-[min(1120px,100%)]">
        <MotionReveal client:visible>
          <span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">Competências</span>
          <h2 class="mt-3 text-4xl font-extrabold tracking-tight">Tecnologias e habilidades</h2>
        </MotionReveal>
        <MotionReveal client:visible delay={0.1}>
          <ul class="mt-10 flex flex-wrap gap-3">
            {['HTML','CSS','JavaScript','Astro','React','TypeScript','Tailwind CSS','Framer Motion','Python','FastAPI','MongoDB','MySQL','PostgreSQL','Docker','Git & GitHub','GNU/Linux','Windows Server','Redes, VPN e firewall','Suporte técnico','FlutterFlow'].map((skill) => <li class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold transition hover:-translate-y-0.5 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-950">{skill}</li>)}
          </ul>
        </MotionReveal>
      </div>
    </section>

    <section id="experiencia" class="px-4 py-24">
      <div class="mx-auto w-[min(1120px,100%)]">
        <MotionReveal client:visible>
          <span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">Experiência</span>
          <h2 class="mt-3 text-4xl font-extrabold tracking-tight">Trajetória profissional</h2>
        </MotionReveal>
        <div class="mt-10 grid gap-5">
          <MotionReveal client:visible><article class="rounded-2xl border-l-4 border-blue-600 border border-slate-200 bg-white p-7 shadow-lg dark:border-slate-700 dark:bg-slate-900"><div class="flex flex-wrap justify-between gap-3"><div><strong>Canal Técnico Consultoria e Tecnologia Ltda</strong><p class="text-sm text-slate-500">Técnico de Suporte, Gerente de Suporte e Gerência de Agência</p></div><span class="text-sm text-slate-500">Jul/2010 – Abr/2023</span></div><p class="mt-4 text-slate-600 dark:text-slate-300">Atuação em implantação de sistemas de automação comercial, suporte técnico corporativo, servidores GNU/Linux e Windows Server, bancos MySQL e PostgreSQL, VPNs, firewall, monitoramento, TEF e liderança de equipe.</p></article></MotionReveal>
          <MotionReveal client:visible delay={0.08}><article class="rounded-2xl border-l-4 border-blue-600 border border-slate-200 bg-white p-7 shadow-lg dark:border-slate-700 dark:bg-slate-900"><div class="flex flex-wrap justify-between gap-3"><div><strong>Soledade Comercial de Alimentos Ltda</strong><p class="text-sm text-slate-500">Encarregado de TI</p></div><span class="text-sm text-slate-500">Jun/2009 – Dez/2009</span></div><p class="mt-4 text-slate-600 dark:text-slate-300">Responsável pela equipe de TI e pelo suporte aos usuários da rede, com foco em estabilidade operacional, comunicação entre lojas e desempenho do software de automação comercial.</p></article></MotionReveal>
          <MotionReveal client:visible delay={0.16}><article class="rounded-2xl border-l-4 border-blue-600 border border-slate-200 bg-white p-7 shadow-lg dark:border-slate-700 dark:bg-slate-900"><div class="flex flex-wrap justify-between gap-3"><div><strong>Serviços Brisa Brasil Ltda</strong><p class="text-sm text-slate-500">Operador de Monitoramento</p></div><span class="text-sm text-slate-500">Dez/2005 – Nov/2006</span></div><p class="mt-4 text-slate-600 dark:text-slate-300">Monitoramento da comunicação entre agências do Banco do Brasil, suporte em rede e contato com ambientes de comunicação Cisco.</p></article></MotionReveal>
        </div>
      </div>
    </section>

    <section id="formacao" class="border-y border-slate-200 bg-white px-4 py-24 dark:border-slate-800 dark:bg-slate-900">
      <div class="mx-auto grid w-[min(1120px,100%)] gap-6 lg:grid-cols-2">
        <MotionReveal client:visible><div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-xl dark:border-slate-700 dark:bg-slate-950"><span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">Formação</span><h3 class="mt-3 text-2xl font-bold">Análise e Desenvolvimento de Sistemas</h3><p class="mt-4 text-slate-600 dark:text-slate-300">Graduação concluída em 2023 pela UNIFAEL Centro Universitário, com foco em análise, levantamento de necessidades, desenvolvimento de sistemas e metodologias aplicadas ao mercado de tecnologia.</p></div></MotionReveal>
        <MotionReveal client:visible delay={0.12}><div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-xl dark:border-slate-700 dark:bg-slate-950"><span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">Direção</span><h3 class="mt-3 text-2xl font-bold">Desenvolvimento de software</h3><p class="mt-4 text-slate-600 dark:text-slate-300">Minha direção atual é crescer como desenvolvedor de software e web, construindo produtos digitais, sistemas e experiências web com responsabilidade, aprendizado contínuo e foco em resultado.</p></div></MotionReveal>
      </div>
    </section>

    <section id="contato" class="px-4 py-24">
      <MotionReveal client:visible className="mx-auto max-w-3xl text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">Contato</span>
        <h2 class="mt-3 text-4xl font-extrabold tracking-tight">Vamos conversar</h2>
        <p class="mt-4 text-slate-600 dark:text-slate-300">Estou aberto a oportunidades em desenvolvimento web, desenvolvimento de software e projetos digitais.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="mailto:nunowired@gmail.com" class="rounded-full border border-slate-300 bg-white px-5 py-3 font-semibold transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900">nunowired@gmail.com</a>
          <a href="https://www.linkedin.com/in/nunowired" target="_blank" rel="noopener" class="rounded-full border border-slate-300 bg-white px-5 py-3 font-semibold transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900">LinkedIn</a>
          <a href="https://github.com/NunoWired" target="_blank" rel="noopener" class="rounded-full border border-slate-300 bg-white px-5 py-3 font-semibold transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900">GitHub</a>
          <a href="tel:+5561992505501" class="rounded-full border border-slate-300 bg-white px-5 py-3 font-semibold transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900">+55 (61) 99250-5501</a>
        </div>
      </MotionReveal>
    </section>
  </main>

  <Footer lang="pt-BR" />
</BaseLayout>